# Copy this file to backend/.env and fill in the values. Never commit the real .env.
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=4000

# --- PostgreSQL Connection
# Use the direct connection URL for Neon/PostgreSQL (avoid pooler host for migrations and advisory locks).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- TLS Certificate Verification (Production Hardening)
# Set to true to enforce strict CA validation in production; false only for dev/testing environments without CA chains.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional: path to custom trusted CA certificate file (e.g. /etc/ssl/certs/db-ca.crt or PEM string)
DATABASE_CA_CERT=

# --- Redis (BullMQ queues and risk velocity counters)
REDIS_URL=redis://default:PASSWORD@HOST:PORT
REDIS_KEY_PREFIX=bgc-dev

# --- Cryptographic Secrets (minimum 32 characters in production)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
WEBHOOK_SIGNING_SECRET=your_webhook_secret_at_least_32_characters_long
CRON_SECRET=your_cron_secret_at_least_32_characters_long

# --- Web / CORS
# The exact origin of the frontend (e.g. http://localhost:5173 in dev or https://balanceguard-core.pages.dev in prod)
CORS_ORIGIN=http://localhost:5173
API_RATE_LIMIT_MAX=5000           # Max requests per 15 minutes per IP (defaults to 5000 in dev, 300 in prod)

# --- Runtime switches
RUN_WORKER=true               # Run background BullMQ worker in this process
RUN_MIGRATIONS_ON_START=true  # Apply pending migrations on startup (set false in controlled CI/CD deployments)
DEMO_MODE=true                # Enable demo logins and demo features (must be false in production unless allowed below)
ALLOW_PRODUCTION_DEMO_MODE=false # Explicit override allowing DEMO_MODE in a production demo/portfolio deployment

# --- AI Risk Explanations (Gemini API)
# Optional: leave empty to use deterministic template explanations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
HOLD_THRESHOLD=75             # Risk score (0-100) at which transfers are held for human review

# --- Passwords for seeded accounts (minimum 12 characters in production)
SEED_ADMIN_PASSWORD=your_seed_admin_password_min_12_chars
SEED_REVIEWER_PASSWORD=your_seed_reviewer_password_min_12_chars
